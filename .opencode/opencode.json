{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "opensassi": "allow"
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest", "--headless"],
      "enabled": true
    },
    "debugger": {
      "type": "local",
      "command": ["gdb-mcp-server"],
      "enabled": true
    }
  }
}
